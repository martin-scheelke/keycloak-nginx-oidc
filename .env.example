# Copy to .env (git-ignored) to override defaults for docker compose.

# Keycloak bootstrap admin (console at http://localhost:8080/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Must match the "secret" of client "demo-app" in docker/keycloak/realm-demo.json
DEMO_APP_CLIENT_SECRET=demo-app-secret
